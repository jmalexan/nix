{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Update Watch now owns dependency discovery and pull-request creation.
  // Keep the old policy below as rollback documentation, but do not let the
  // hosted app create duplicate pull requests.
  "enabled": false,

  // Keep the update queue visible in one issue. Updates create reviewable PRs;
  // nothing is merged automatically until the checks have earned our trust.
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard"
  ],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "automerge": false,
  "labels": ["dependencies"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 6,

  // Renovate's native Nix manager updates flake inputs and supports periodic
  // lock-file maintenance. It is opt-in while the manager remains in beta.
  "nix": {
    "enabled": true
  },
  // Digest pinning is a manager capability, not only a Docker datasource
  // policy. The explicit regex setting lets the custom manager insert an
  // initial @sha256 value and then verify it while generating the branch.
  "regex": {
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },

  // Nix expressions are not a built-in container manifest format. Each image
  // is paired with an explicit `renovate:` comment; only annotated values are
  // eligible for replacement.
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images declared in Nix modules",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[\\t ]*\\r?\\n(?<indentation>[\\t ]+)(?<depType>image|dockerImage)[\\t ]*=[\\t ]*\"(?<packageName>[^\"\\n]+?):(?<currentValue>[^\"@\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      // Templates only retain Renovate's documented capture fields. Rebuild
      // the annotation from those fields and preserve the declared image name
      // so re-extraction keeps the same dependency at the same index.
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n{{{indentation}}}{{{depType}}} = \"{{{packageName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\";",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ],

  "packageRules": [
    {
      "description": "Require an explicit dashboard click for breaking container upgrades",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep coupled Immich application images on one release",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "Immich application images"
    },
    {
      "description": "Keep the existing Immich database on PostgreSQL 14 until a migration is planned",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "allowedVersions": "/^14-/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Do not silently cross Frigate hardware image variants",
      "matchPackageNames": ["ghcr.io/blakeblackshear/frigate"],
      "versionCompatibility": "^(?<version>.*?)(?<compatibility>-tensorrt)$"
    }
  ]
}
