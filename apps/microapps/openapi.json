  "components": {
    "schemas": {
      "Ceremony": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Challenge Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "credential"
        ],
        "title": "Ceremony"
      },
      "ConnectionResult": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "closed",
              "failed",
              "expired"
            ],
            "title": "Outcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "ConnectionResult"
      },
      "ConnectionScope": {
        "properties": {
          "target": {
            "type": "string",
            "const": "nasa",
            "title": "Target",
            "default": "nasa"
          },
          "account": {
            "type": "string",
            "const": "nasa-automation",
            "title": "Account",
            "default": "nasa-automation"
          },
          "max_seconds": {
            "type": "integer",
            "const": 900,
            "title": "Max Seconds",
            "default": 900
          },
          "public_key": {
            "type": "string",
            "maxLength": 128,
            "title": "Public Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "public_key"
        ],
        "title": "ConnectionScope"
      },
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ],
            "title": "Decision"
          },
          "connection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionScope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Decision"
      },
      "Enrollment": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Enrollment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewRequest": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "demo.verify",
              "ssh.connect"
            ],
            "title": "Operation"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "connection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionScope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "reason"
        ],
        "title": "NewRequest"
      },
      "RequestView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "requester": {
            "type": "string",
            "title": "Requester"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "created": {
            "type": "number",
            "title": "Created"
          },
          "expires": {
            "type": "number",
            "title": "Expires"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "connection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionScope"
              },
              {
                "type": "null"
              }
            ]
          },
          "connection_deadline": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connection Deadline"
          }
        },
        "type": "object",
        "required": [
          "id",
          "requester",
          "reason",
          "operation",
          "state",
          "created",
          "expires",
          "result"
        ],
        "title": "RequestView"
      },
      "SessionView": {
        "properties": {
          "csrf": {
            "type": "string",
            "title": "Csrf"
          },
          "vapid_public": {
            "type": "string",
            "title": "Vapid Public"
          }
        },
        "type": "object",
        "required": [
          "csrf",
          "vapid_public"
        ],
        "title": "SessionView"
      },
      "Subscription": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 2048,
            "title": "Endpoint"
          },
          "keys": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Keys"
          },
          "expirationTime": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expirationtime"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "title": "Subscription"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
