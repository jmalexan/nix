  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ],
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "severity",
          "message"
        ],
        "title": "Alert"
      },
      "AuthMethods": {
        "properties": {
          "password": {
            "type": "boolean",
            "title": "Password"
          },
          "passkey": {
            "type": "boolean",
            "title": "Passkey"
          },
          "setup": {
            "type": "boolean",
            "title": "Setup"
          }
        },
        "type": "object",
        "required": [
          "password",
          "passkey",
          "setup"
        ],
        "title": "AuthMethods"
      },
      "Ceremony": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Challenge Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "credential"
        ],
        "title": "Ceremony"
      },
      "Dataset": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "used": {
            "type": "integer",
            "title": "Used"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "mountpoint": {
            "type": "string",
            "title": "Mountpoint"
          },
          "snapshots_enabled": {
            "type": "boolean",
            "title": "Snapshots Enabled"
          },
          "snapshot_interval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Interval"
          },
          "snapshot_policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Policy"
          },
          "snapshot_count": {
            "type": "integer",
            "title": "Snapshot Count"
          },
          "latest_snapshot": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Snapshot"
          },
          "latest_automatic": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Automatic"
          },
          "offsite": {
            "type": "string",
            "title": "Offsite"
          }
        },
        "type": "object",
        "required": [
          "name",
          "used",
          "available",
          "mountpoint",
          "snapshots_enabled",
          "snapshot_count",
          "offsite"
        ],
        "title": "Dataset"
      },
      "Disk": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "read": {
            "type": "integer",
            "title": "Read"
          },
          "write": {
            "type": "integer",
            "title": "Write"
          },
          "checksum": {
            "type": "integer",
            "title": "Checksum"
          }
        },
        "type": "object",
        "required": [
          "name",
          "state",
          "read",
          "write",
          "checksum"
        ],
        "title": "Disk"
      },
      "Enrollment": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Enrollment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Healthy": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Healthy"
      },
      "PasswordEnrollment": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 15,
            "title": "Password"
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "token"
        ],
        "title": "PasswordEnrollment"
      },
      "PasswordLogin": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "PasswordLogin"
      },
      "PasswordStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "PasswordStatus"
      },
      "Pool": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "health": {
            "type": "string",
            "title": "Health"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "allocated": {
            "type": "integer",
            "title": "Allocated"
          },
          "free": {
            "type": "integer",
            "title": "Free"
          },
          "capacity": {
            "type": "number",
            "title": "Capacity"
          },
          "scan": {
            "type": "string",
            "title": "Scan"
          },
          "scrub_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scrub At"
          },
          "disks": {
            "items": {
              "$ref": "#/components/schemas/Disk"
            },
            "type": "array",
            "title": "Disks"
          },
          "data_errors": {
            "type": "string",
            "title": "Data Errors"
          }
