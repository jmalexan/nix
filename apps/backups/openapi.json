        "type": "object",
        "required": [
          "name",
          "health",
          "size",
          "allocated",
          "free",
          "capacity",
          "scan",
          "data_errors"
        ],
        "title": "Pool"
      },
      "Report": {
        "properties": {
          "collected_at": {
            "type": "number",
            "title": "Collected At"
          },
          "pools": {
            "items": {
              "$ref": "#/components/schemas/Pool"
            },
            "type": "array",
            "title": "Pools"
          },
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/Dataset"
            },
            "type": "array",
            "title": "Datasets"
          },
          "snapshots": {
            "items": {
              "$ref": "#/components/schemas/Snapshot"
            },
            "type": "array",
            "title": "Snapshots"
          },
          "retained_snapshots": {
            "type": "integer",
            "title": "Retained Snapshots",
            "default": 0
          },
          "backup": {
            "$ref": "#/components/schemas/Run"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "type": "array",
            "title": "History"
          },
          "backup_state": {
            "type": "string",
            "title": "Backup State",
            "default": "unknown"
          },
          "database_state": {
            "type": "string",
            "title": "Database State",
            "default": "unknown"
          },
          "next_backup": {
            "type": "string",
            "title": "Next Backup",
            "default": "Unknown"
          },
          "repository": {
            "type": "string",
            "title": "Repository"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Paths"
          },
          "exclusions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exclusions"
          },
          "retention": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Retention"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "collected_at",
          "repository",
          "paths",
          "exclusions",
          "retention"
        ],
        "title": "Report"
      },
      "Run": {
        "properties": {
          "started": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started"
          },
          "finished": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished"
          },
          "result": {
            "type": "string",
            "title": "Result",
            "default": "unknown"
          },
          "exit_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Status"
          },
          "last_success": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          }
        },
        "type": "object",
        "title": "Run"
      },
      "SessionView": {
        "properties": {
          "csrf": {
            "type": "string",
            "title": "Csrf"
          }
        },
        "type": "object",
        "required": [
          "csrf"
        ],
        "title": "SessionView"
      },
      "Snapshot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "time": {
            "type": "number",
            "title": "Time"
          },
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Paths"
          },
          "bytes_processed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bytes Processed"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          }
        },
        "type": "object",
        "required": [
          "id",
          "time",
          "hostname",
          "paths"
        ],
        "title": "Snapshot"
      },
      "Status": {
        "properties": {
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Report"
              },
              {
                "type": "null"
              }
            ]
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "title": "Alerts"
          },
          "checked_at": {
            "type": "number",
            "title": "Checked At"
          }
        },
        "type": "object",
        "required": [
          "alerts",
          "checked_at"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
