  "components": {
    "schemas": {
      "ActionStatus": {
        "properties": {
          "prConfigured": {
            "type": "boolean",
            "title": "Prconfigured"
          },
          "jobs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Jobs"
          },
          "pullRequests": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Pullrequests"
          }
        },
        "type": "object",
        "required": [
          "prConfigured",
          "jobs",
          "pullRequests"
        ],
        "title": "ActionStatus"
      },
      "AuthMethods": {
        "properties": {
          "password": {
            "type": "boolean",
            "title": "Password"
          },
          "passkey": {
            "type": "boolean",
            "title": "Passkey"
          },
          "setup": {
            "type": "boolean",
            "title": "Setup"
          }
        },
        "type": "object",
        "required": [
          "password",
          "passkey",
          "setup"
        ],
        "title": "AuthMethods"
      },
      "Ceremony": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Challenge Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "credential"
        ],
        "title": "Ceremony"
      },
      "CreatePR": {
        "properties": {
          "action": {
            "type": "string",
            "const": "create-pr",
            "title": "Action"
          },
          "kind": {
            "type": "string",
            "enum": [
              "container",
              "action",
              "nix"
            ],
            "title": "Kind"
          },
          "target": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "kind",
          "target"
        ],
        "title": "CreatePR"
      },
      "DashboardStatus": {
        "properties": {
          "reports": {
            "additionalProperties": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Reports"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History"
          },
          "actions": {
            "$ref": "#/components/schemas/ActionStatus"
          }
        },
        "type": "object",
        "required": [
          "reports",
          "history",
          "actions"
        ],
        "title": "DashboardStatus"
      },
      "Enrollment": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Enrollment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Healthy": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Healthy"
      },
      "PasswordEnrollment": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 15,
            "title": "Password"
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "token"
        ],
        "title": "PasswordEnrollment"
      },
      "PasswordLogin": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "PasswordLogin"
      },
      "PasswordSet": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 15,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "PasswordSet"
      },
      "PasswordStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "PasswordStatus"
      },
      "Queued": {
        "properties": {
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "title": "Queued"
      },
      "Scan": {
        "properties": {
          "action": {
            "type": "string",
            "const": "scan",
            "title": "Action"
          },
          "target": {
            "type": "string",
            "enum": [
              "containers",
              "actions",
              "nix"
            ],
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "target"
        ],
        "title": "Scan"
      },
      "SessionView": {
        "properties": {
          "csrf": {
            "type": "string",
            "title": "Csrf"
          }
        },
        "type": "object",
        "required": [
          "csrf"
        ],
        "title": "SessionView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
