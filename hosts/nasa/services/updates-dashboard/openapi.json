                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Scan"
                  },
                  {
                    "$ref": "#/components/schemas/CreatePR"
                  }
                ],
                "title": "Body",
                "discriminator": {
                  "propertyName": "action",
                  "mapping": {
